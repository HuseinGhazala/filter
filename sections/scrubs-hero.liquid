{{ 'section-scrubs-hero.css' | asset_url | stylesheet_tag }}

{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_color_rgb = section.settings.text_color | color_to_rgb %}
{% assign btn_bg_rgb = section.settings.button_bg_color | color_to_rgb %}
{% assign btn_text_rgb = section.settings.button_text_color | color_to_rgb %}

<style>
  section[id="shopify-section-{{ section.id }}"] {
    {%- if section.settings.background_color != blank and section.settings.background_color != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' -%}
      --sh-bg-color: {{ section.settings.background_color }};
    {%- endif -%}

    {%- if section.settings.text_color != blank and section.settings.text_color != 'transparent' and text_color_rgb != 'rgba(0, 0, 0, 0.0)' -%}
      --sh-text-color: {{ section.settings.text_color }};
    {%- endif -%}

    {%- if section.settings.button_bg_color != blank and section.settings.button_bg_color != 'transparent' and btn_bg_rgb != 'rgba(0, 0, 0, 0.0)' -%}
      --sh-btn-bg: {{ section.settings.button_bg_color }};
    {%- endif -%}

    {%- if section.settings.button_text_color != blank and section.settings.button_text_color != 'transparent' and btn_text_rgb != 'rgba(0, 0, 0, 0.0)' -%}
      --sh-btn-text: {{ section.settings.button_text_color }};
    {%- endif -%}

    --sh-btn-radius: {{ section.settings.button_border_radius }}px;

    {%- if section.settings.margin_top -%}
      --section-gap-top: {{ section.settings.margin_top }}px;
    {%- endif -%}

    {%- if section.settings.margin_bottom -%}
      --section-gap-bottom: {{ section.settings.margin_bottom }}px;
    {%- endif -%}

    {%- if section.settings.show_mobile_spacing -%}
      --section-gap-top-mobile: {{ section.settings.margin_top_mobile }}px;
      --section-gap-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
    {%- endif -%}
  }
</style>

<div class="scrubs-hero">
  {%- comment -%} Background Images {%- endcomment -%}
  {%- if section.settings.desktop_image != blank -%}
    {{
      section.settings.desktop_image
      | image_url: width: 1920
      | image_tag:
        loading: 'lazy',
        widths: '990, 1200, 1440, 1920',
        sizes: '100vw',
        class: 'scrubs-hero__bg-img scrubs-hero__bg-img--desktop'
    }}
  {%- endif -%}

  {%- if section.settings.mobile_image != blank -%}
    {{
      section.settings.mobile_image
      | image_url: width: 900
      | image_tag:
        loading: 'lazy',
        widths: '375, 500, 750, 900',
        sizes: '100vw',
        class: 'scrubs-hero__bg-img scrubs-hero__bg-img--mobile'
    }}
  {%- elsif section.settings.desktop_image != blank -%}
    {%- comment -%} Fallback: use desktop image on mobile {%- endcomment -%}
    {{
      section.settings.desktop_image
      | image_url: width: 900
      | image_tag:
        loading: 'lazy',
        widths: '375, 500, 750, 900',
        sizes: '100vw',
        class: 'scrubs-hero__bg-img scrubs-hero__bg-img--mobile'
    }}
  {%- else -%}
    {%- comment -%} Placeholder when no images uploaded {%- endcomment -%}
    <div class="scrubs-hero__bg-placeholder"></div>
  {%- endif -%}

  {%- comment -%} Content Overlay {%- endcomment -%}
  <div class="scrubs-hero__content {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="scrubs-hero__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <div class="scrubs-hero__subtitle rte">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="scrubs-hero__button"
      >
        {{- section.settings.button_text -}}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} Badge / Logo (optional) {%- endcomment -%}
  {%- if section.settings.badge_image != blank -%}
    <div class="scrubs-hero__badge">
      {{
        section.settings.badge_image
        | image_url: width: 200
        | image_tag:
          loading: 'lazy',
          widths: '80, 100, 200',
          class: 'scrubs-hero__badge-img'
      }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Scrubs Hero Banner",
  "tag": "section",
  "class": "wt-shopify-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.global.general"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.settings.settings.heading.label",
      "default": "سكربات طبية فضفاضة"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>قصّات ساترة، ألوان تناسب بيئة العمل، وخامات تتحمّل الاستخدام اليومي.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "تسوّقي الآن"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "unit": "px",
      "step": 2,
      "default": 0,
      "label": "Button Border Radius"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Background Image",
      "info": "Recommended: 1440×420px or wider"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Background Image",
      "info": "Recommended: 750×900px. Falls back to desktop image if empty."
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge / Logo",
      "info": "Optional circular badge shown at the bottom-right corner"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.settings.settings.background-color.label",
      "default": "#EDE8E0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.settings.settings.text-color.label",
      "default": "#1A2744"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#1A2744"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 0,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 0,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_spacing",
      "label": "t:sections.settings.settings.show-mobile-spacing.label"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-top-mobile.label",
      "visible_if": "{{ section.settings.show_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-bottom-mobile.label",
      "visible_if": "{{ section.settings.show_mobile_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "Scrubs Hero Banner",
      "category": "t:sections.categories.featured"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
